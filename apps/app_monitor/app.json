{
  "id": "app_monitor",
  "title": "App Monitor",
  "description": "Memory, CPU and run time of every running app, against the limits in its oapAppSettings (read-only)",
  "version": "1.0.0",
  "vendor": "custom",
  "loggingId": "OAA6",
  "iconGlyph": "MEM",
  "signals": {},
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "App Monitor",
      "buttons": [
        ["BTN_SORT", "Sort"],
        ["BTN_PAGE", "Next page"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "interval", "label": "Refresh every", "type": "number", "unit": "s", "default": 3, "steps": [1, 2, 3, 5, 10]},
    {"key": "scope", "label": "Show", "type": "choice", "default": "custom",
     "options": [["custom", "Custom apps"], ["all", "All apps"]]},
    {"key": "sort", "label": "Sort by", "type": "choice", "default": "pct",
     "options": [["pct", "Share of memory limit"], ["rss", "Memory"], ["cpu", "CPU"], ["uptime", "Running time"], ["name", "Name"]]},
    {"key": "warnAt", "label": "Warn at", "type": "number", "unit": "%", "default": 80, "steps": [50, 60, 70, 75, 80, 85, 90, 95]},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
